# Supabase — copy this file to .env.local and fill in the real values.
# Both are safe to expose in the browser (the anon key is protected by RLS).
# Find them in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary — stage photo/video uploads. Both safe to expose in the browser;
# the upload preset MUST be "Unsigned" (Cloudinary dashboard → Settings →
# Upload → Upload presets). Never put the API Secret here or anywhere in the
# frontend — it only lives in the delete-media Edge Function's secrets.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
