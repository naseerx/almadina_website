{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/new", "destination": "/app" },
    { "source": "/admin", "destination": "/app" },
    { "source": "/admin/:path*", "destination": "/app" },
    { "source": "/track/:path*", "destination": "/app" },
    { "source": "/ongoing-project/:path*", "destination": "/app" }
  ],
  "headers": [
    { "source": "/app", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/new", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/track/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/ongoing-project/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
